/* 外卖小程序 — 全局样式 */

page {
  --primary: #ff6b35;
  --primary-dark: #e05520;
  --primary-light: #fff2e8;
  --success: #52c41a;
  --warning: #faad14;
  --danger: #ff4d4f;
  --bg: #f5f5f5;
  --white: #fff;
  --text: #333;
  --text-secondary: #666;
  --text-muted: #999;
  --border: #f0f0f0;
  --shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 28rpx;
  color: var(--text);
}

/* ====== 通用卡片 ====== */
.card {
  background: var(--white);
  border-radius: 20rpx;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
}

/* ====== 通用按钮 ====== */
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-success {
  background: linear-gradient(135deg, #52c41a, #3cb371);
  color: #fff;
  border-radius: 44rpx;
  font-weight: 600;
  border: none;
}

/* ====== 价格文字 ====== */
.price {
  color: var(--primary);
  font-weight: bold;
}

.price::before {
  content: '¥';
  font-size: 0.75em;
}

/* ====== 空状态 ====== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-state .icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-state .text {
  color: var(--text-muted);
  font-size: 28rpx;
}

/* ====== 加载中 ====== */
.loading-spinner {
  display: flex;
  justify-content: center;
  padding: 48rpx;
}

/* ====== 标签 ====== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-pending  { background: #fffbe6; color: #d48806; }
.tag-accepted { background: #e6f7ff; color: #096dd9; }
.tag-delivering { background: #f9f0ff; color: #531dab; }
.tag-completed  { background: #f6ffed; color: #389e0d; }
.tag-cancelled  { background: #fafafa; color: #999; }
