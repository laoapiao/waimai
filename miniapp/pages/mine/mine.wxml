<!-- 我的 — 个人中心 -->
<view class="page">

  <!-- 头部 -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="avatar-wrap">
        <view class="avatar">
          <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" />
          <text wx:else class="avatar-placeholder">👤</text>
          <view class="avatar-camera">📷</view>
        </view>
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" />
      </view>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickname || '未登录'}}</text>
        <text class="phone">{{userInfo.phone || '点击登录'}}</text>
      </view>
      <view class="role-tag">{{roleText}}</view>
    </view>
  </view>

  <!-- 订单统计 -->
  <view class="stats-card">
    <view class="stat-item" bindtap="goOrders" data-status="">
      <text class="stat-num">{{stats.all}}</text>
      <text class="stat-label">全部订单</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goOrders" data-status="pending">
      <text class="stat-num pending">{{stats.pending}}</text>
      <text class="stat-label">待接单</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goOrders" data-status="delivering">
      <text class="stat-num delivering">{{stats.delivering}}</text>
      <text class="stat-label">配送中</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goOrders" data-status="completed">
      <text class="stat-num completed">{{stats.completed}}</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goAddress">
      <text class="menu-icon">📍</text>
      <text class="menu-title">收货地址管理</text>
      <text class="menu-desc">{{addressCount > 0 ? addressCount + '个地址' : '未设置'}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goReviews">
      <text class="menu-icon">⭐</text>
      <text class="menu-title">我的评价</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goFeedback">
      <text class="menu-icon">📝</text>
      <text class="menu-title">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <text class="menu-icon">🏪</text>
      <text class="menu-title">关于菜市</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="contactService">
      <text class="menu-icon">💬</text>
      <text class="menu-title">联系客服</text>
      <text class="menu-desc">工作时间 6:00-21:00</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-icon">🗑️</text>
      <text class="menu-title">清除缓存</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 版本 -->
  <view class="version">外卖点餐 v1.0.0</view>

</view>
