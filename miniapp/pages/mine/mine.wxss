/* 我的 — 个人中心 */

.page { padding-bottom: 40rpx; background: #f5f5f5; min-height: 100vh; }

/* === 头部 === */
.header { position: relative; padding-bottom: 40rpx; padding-top: 60rpx; }
.header-bg {
  height: 280rpx;
  background: linear-gradient(160deg, #ff6b35 0%, #e05520 60%, #c9401a 100%);
  border-radius: 0 0 48rpx 48rpx;
}
.header-content {
  display: flex; flex-direction: row; align-items: center; gap: 20rpx;
  margin-top: -200rpx; padding: 0 32rpx;
  position: relative; z-index: 2;
}
.avatar-wrap { position: relative; width: 120rpx; height: 120rpx; flex-shrink: 0; }
.avatar-btn {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%; opacity: 0;
  padding: 0; margin: 0; border: none;
}
.avatar-btn::after { border: none; width: 0; height: 0; }
.avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #fff; display: flex; align-items: center;
  justify-content: center; font-size: 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
  border: 4rpx solid #fff; position: relative; overflow: visible;
}
.avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.avatar-placeholder { font-size: 56rpx; }
.avatar-camera {
  position: absolute; bottom: -4rpx; right: -4rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #ff6b35; display: flex;
  align-items: center; justify-content: center;
  font-size: 22rpx; border: 3rpx solid #fff;
}
.user-info { flex: 1; }
.nickname-wrap {
  position: relative; display: flex; align-items: center; gap: 8rpx;
}
.nickname {
  font-size: 36rpx; font-weight: 800; color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}
.nickname-hint { font-size: 24rpx; color: rgba(255,255,255,0.6); }
.nickname-input {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0; width: 100%; height: 100%;
}
.phone { display: block; font-size: 26rpx; color: rgba(255,255,255,0.85); margin-top: 4rpx; }
.role-tag {
  background: rgba(255,255,255,0.25); color: #fff;
  padding: 8rpx 20rpx; border-radius: 20rpx;
  font-size: 24rpx;
}

/* === 统计卡片 === */
.stats-card {
  display: flex; margin: -20rpx 24rpx 20rpx;
  background: #fff; border-radius: 24rpx;
  padding: 24rpx 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
  position: relative; z-index: 3;
}
.stat-item { flex: 1; text-align: center; }
.stat-divider { width: 1rpx; background: #f0f0f0; margin: 8rpx 0; }
.stat-num { font-size: 44rpx; font-weight: 800; color: #333; display: block; }
.stat-num.pending { color: #faad14; }
.stat-num.delivering { color: #722ed1; }
.stat-num.completed { color: #52c41a; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }

/* === 菜单 === */
.menu-section {
  background: #fff; border-radius: 20rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  overflow: hidden;
}
.menu-item {
  display: flex; align-items: center; padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 16rpx; }
.menu-title { font-size: 30rpx; flex: 1; color: #333; }
.menu-desc { font-size: 24rpx; color: #999; margin-right: 12rpx; }
.menu-arrow { font-size: 36rpx; color: #ccc; }

/* === 版本 === */
.version { text-align: center; font-size: 24rpx; color: #ccc; padding: 32rpx; }
