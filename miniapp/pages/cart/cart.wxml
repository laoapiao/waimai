<!-- 购物车 -->

<!-- 空状态 -->
<view wx:if="{{cart.length === 0}}" class="empty-page">
  <view class="empty-icon-wrap">
    <text class="empty-icon">🛒</text>
  </view>
  <text class="empty-title">购物车空空如也</text>
  <text class="empty-desc">快去挑些新鲜食材吧~</text>
  <button class="empty-btn" bindtap="goShop">去逛逛</button>
</view>

<view wx:else class="page">

  <!-- 顶部标题栏 -->
  <view class="cart-header">
    <text class="cart-title">🛒 购物车</text>
    <text class="cart-count">共 {{totalCount}} 件商品</text>
  </view>

  <!-- 商品列表 -->
  <view class="cart-list">
    <view wx:for="{{cart}}" wx:key="id" class="cart-item">
      <!-- 图片 -->
      <view class="item-img-wrap">
        <image class="item-image" src="{{item.image || '/images/default-food.png'}}" mode="aspectFill" />
      </view>

      <!-- 信息 -->
      <view class="item-body">
        <text class="item-name">{{item.name}}</text>
        <view class="item-bottom">
          <view class="item-price-wrap">
            <text class="item-price">¥{{item.price}}</text>
            <text class="item-subtotal">小计 ¥{{item.subtotal}}</text>
          </view>

          <!-- 数量调节 -->
          <view class="qty-stepper">
            <view class="item-del" bindtap="removeItem" data-id="{{item.id}}">
              <text>🗑️</text>
            </view>
            <view class="qty-btn {{item.quantity <= 1 ? 'qty-disabled' : ''}}" bindtap="decrease" data-id="{{item.id}}">
              <text class="qty-icon">−</text>
            </view>
            <text class="qty-num">{{item.quantity}}</text>
            <view class="qty-btn qty-plus" bindtap="increase" data-id="{{item.id}}">
              <text class="qty-icon">+</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view class="footer">
    <view class="footer-info">
      <view class="footer-row">
        <text class="footer-label">商品合计</text>
        <text class="footer-val">¥{{totalPrice}}</text>
      </view>
      <view class="footer-row">
        <text class="footer-label">配送费</text>
        <text class="footer-val free">免配送费</text>
      </view>
      <view class="footer-divider"></view>
      <view class="footer-row total-row">
        <text class="footer-label">应付</text>
        <text class="footer-total">¥{{totalPrice}}</text>
      </view>
    </view>
    <view class="footer-btn {{totalPrice <= 0 ? 'btn-disabled' : ''}}" bindtap="goOrder">
      <text>立即下单</text>
    </view>
  </view>

</view>
