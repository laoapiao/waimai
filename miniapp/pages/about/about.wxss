.page { padding: 24rpx; min-height: 100vh; background: #f5f5f5; }
.logo-card { text-align: center; padding: 48rpx 0 40rpx; }
.logo { font-size: 80rpx; display: block; }
.name { font-size: 40rpx; font-weight: 800; display: block; margin-top: 16rpx; }
.slogan { font-size: 26rpx; color: #999; display: block; margin-top: 8rpx; }
.section { background: #fff; border-radius: 20rpx; margin-bottom: 16rpx; overflow: hidden; }
.row { display: flex; justify-content: space-between; padding: 26rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.row:last-child { border-bottom: none; }
.label { font-size: 28rpx; color: #333; }
.val { font-size: 28rpx; color: #666; }
.version { text-align: center; color: #ccc; font-size: 24rpx; padding: 40rpx; }
