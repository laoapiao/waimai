/* 商品详情 */

.detail-image { width: 100%; height: 500rpx; background: #f5f5f5; }

.detail-info {
  background: #fff; border-radius: 28rpx 28rpx 0 0;
  margin-top: -28rpx; padding: 32rpx;
  position: relative; z-index: 2;
  margin-bottom: 120rpx;
}

.detail-name { font-size: 38rpx; font-weight: 800; color: #333; margin-bottom: 12rpx; }
.detail-price { font-size: 48rpx; font-weight: 800; color: #ff6b35; margin-bottom: 16rpx; }

.detail-meta { display: flex; gap: 32rpx; font-size: 24rpx; color: #999; margin-bottom: 32rpx; }
.detail-meta text { background: #f5f5f5; padding: 6rpx 16rpx; border-radius: 8rpx; }

.detail-desc { padding-top: 28rpx; border-top: 1rpx solid #f0f0f0; }
.detail-desc .title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.detail-desc .content { font-size: 28rpx; color: #666; line-height: 1.8; }

/* 底部 */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; padding: 20rpx 24rpx;
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}

.qty-btn {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: #f5f5f5; display: flex;
  align-items: center; justify-content: center;
  font-size: 36rpx; color: #333;
}
.qty-input { width: 80rpx; text-align: center; font-size: 32rpx; font-weight: 600; }

.add-cart-btn {
  background: linear-gradient(135deg, #ff6b35, #e05520);
  color: #fff; border-radius: 40rpx;
  padding: 0 56rpx; height: 80rpx; line-height: 80rpx;
  font-size: 30rpx; font-weight: 600; border: none;
  box-shadow: 0 6rpx 16rpx rgba(255,107,53,0.3);
}
