/* 确认下单 */

.page { padding-bottom: 130rpx; }

.section {
  background: #fff; margin: 16rpx 24rpx;
  border-radius: 20rpx; padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.section-title {
  font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx;
  padding-bottom: 16rpx; border-bottom: 1rpx solid #f5f5f5;
}

.form-item { display: flex; align-items: center; margin-bottom: 18rpx; }
.label { width: 140rpx; font-size: 26rpx; color: #666; }
.input { flex: 1; font-size: 28rpx; padding: 14rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.locate-btn { font-size: 38rpx; padding: 0 8rpx; margin-left: 8rpx; }

.order-item { display: flex; align-items: center; margin-bottom: 14rpx; }
.oi-image { width: 80rpx; height: 80rpx; border-radius: 12rpx; background: #f5f5f5; }
.oi-info { flex: 1; padding: 0 16rpx; font-size: 28rpx; }
.oi-right { text-align: right; }
.oi-price { font-size: 28rpx; color: #ff6b35; font-weight: 700; }
.oi-qty { font-size: 24rpx; color: #999; margin-left: 8rpx; }

.amount-row { display: flex; justify-content: space-between; font-size: 30rpx; font-weight: 600; }
.amount-value { color: #ff6b35; }

.submit-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; padding: 24rpx;
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
.total-line { font-size: 28rpx; }
.final-price { font-size: 48rpx; color: #ff6b35; font-weight: 800; }
.submit-btn {
  background: linear-gradient(135deg, #ff6b35, #e05520);
  color: #fff; border-radius: 44rpx; padding: 0 64rpx;
  height: 88rpx; line-height: 88rpx; font-size: 32rpx;
  font-weight: 700; border: none;
  box-shadow: 0 6rpx 18rpx rgba(255,107,53,0.35);
}
