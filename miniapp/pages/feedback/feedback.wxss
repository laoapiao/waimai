.page { padding: 24rpx; min-height: 100vh; background: #f5f5f5; }
.section { background: #fff; border-radius: 24rpx; padding: 32rpx; }
.title { font-size: 34rpx; font-weight: 800; margin-bottom: 8rpx; }
.sub { font-size: 26rpx; color: #999; margin-bottom: 28rpx; }
.textarea { width: 100%; height: 280rpx; background: #fafafa; border-radius: 16rpx; padding: 20rpx; font-size: 28rpx; box-sizing: border-box; }
.count { text-align: right; font-size: 24rpx; color: #ccc; margin: 8rpx 0 20rpx; }
.contact { height: 84rpx; background: #fafafa; border-radius: 16rpx; padding: 0 20rpx; font-size: 28rpx; margin-bottom: 28rpx; }
.submit-btn { background: linear-gradient(135deg, #ff6b35, #e05520); color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 700; height: 88rpx; line-height: 88rpx; border: none; }
