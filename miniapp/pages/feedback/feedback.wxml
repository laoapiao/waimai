<!-- 意见反馈 -->
<view class="page">
  <view class="section">
    <view class="title">💬 告诉我们你的想法</view>
    <view class="sub">对菜品、配送、服务有什么建议？</view>

    <textarea class="textarea" placeholder="请输入你的反馈..." value="{{content}}" bindinput="onInput" maxlength="500" />
    <view class="count">{{content.length}}/500</view>

    <input class="contact" placeholder="联系方式（选填，方便回复）" value="{{contact}}" bindinput="onContact" />

    <button class="submit-btn" bindtap="submit" loading="{{submitting}}">提交反馈</button>
  </view>
</view>
