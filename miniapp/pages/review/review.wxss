/* 评价页 */

.page { padding: 24rpx; }

.section {
  background: #fff; border-radius: 20rpx; padding: 28rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }

.star-row { display: flex; gap: 20rpx; }
.star { font-size: 68rpx; color: #e8e8e8; transition: color 0.15s; }
.star.active { color: #faad14; }

.review-textarea {
  width: 100%; height: 220rpx; font-size: 28rpx; padding: 20rpx;
  background: #f5f5f5; border-radius: 16rpx; box-sizing: border-box;
}

.submit-area { padding: 40rpx 0; }
.submit-btn {
  background: linear-gradient(135deg, #ff6b35, #e05520);
  color: #fff; border-radius: 44rpx; font-size: 32rpx; font-weight: 700;
  height: 92rpx; line-height: 92rpx; border: none;
  box-shadow: 0 6rpx 18rpx rgba(255,107,53,0.35);
}
