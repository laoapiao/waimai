<!-- 首页：左侧分类导航 + 右侧商品列表 -->

<!-- 顶栏 -->
<view class="top-bar">
  <view class="top-bar-inner">
    <view class="top-row">
      <view class="user-brief" bindtap="goMine" wx:if="{{userInfo.nickname}}">
        <image wx:if="{{userInfo.avatar}}" class="user-avatar-sm" src="{{userInfo.avatar}}" mode="aspectFill" />
        <text wx:else class="user-avatar-placeholder">👤</text>
        <text class="user-name-sm">{{userInfo.nickname}}</text>
      </view>
    </view>
    <text class="shop-name">🥬 阿飘菜市</text>
  </view>
</view>

<!-- 公告 -->
<view class="announce-bar" wx:if="{{announcement}}">
  <text class="announce-icon">📢</text>
  <text class="announce-text">{{announcement}}</text>
</view>

<!-- 搜索 -->
<view class="search-wrap">
  <view class="search-box">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索想吃的东西..." value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
  </view>
</view>

<!-- 底部购物车悬浮栏 -->
<view class="cart-float">
  <view class="cart-float-left" bindtap="goCart">
    <view class="cart-float-icon">
      <text>🛒</text>
      <view class="cart-float-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </view>
    <view>
      <text class="cart-float-total" wx:if="{{cartCount > 0}}">¥{{cartTotal}}</text>
      <text class="cart-float-empty" wx:else>购物车是空的</text>
    </view>
  </view>
  <view class="cart-float-btn {{cartCount > 0 ? '' : 'cart-btn-disabled'}}" bindtap="goCart">
    <text>{{cartCount > 0 ? '去结算' : '去选购'}}</text>
  </view>
</view>

<!-- 主体：左侧分类 + 右侧商品 -->
<view class="main-body" style="padding-bottom: 100rpx;">
  <!-- 左侧分类导航 -->
  <scroll-view class="cate-sidebar" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:for="{{categories}}" wx:key="id"
      class="cate-side-item {{activeCategory === item.id ? 'cate-side-active' : ''}}"
      bindtap="switchCategory" data-id="{{item.id}}">
      <text class="cate-side-name">{{item.name}}</text>
      <view wx:if="{{activeCategory === item.id}}" class="cate-side-bar"></view>
    </view>
  </scroll-view>

  <!-- 右侧商品列表 -->
  <scroll-view class="product-scroll" scroll-y enhanced scroll-into-view="{{scrollToId}}" scroll-with-animation>
    <block wx:for="{{groupedProducts}}" wx:key="categoryId">
      <!-- 分类标题 -->
      <view class="section-header" id="cat-{{item.categoryId}}">
        <text class="section-title">{{item.categoryName}}</text>
      </view>

      <!-- 商品网格 -->
      <view class="product-grid">
        <view wx:for="{{item.products}}" wx:key="id" class="p-card" bindtap="goDetail" data-id="{{item.id}}">
          <view class="p-img-wrap">
            <image class="p-img" src="{{item.image || '/images/default-food.png'}}" mode="aspectFill" lazy-load />
            <view wx:if="{{item.sales_count > 0}}" class="p-sales">已售 {{item.sales_count}}</view>
          </view>
          <view class="p-info">
            <text class="p-name">{{item.name}}</text>
            <view class="p-bottom">
              <text class="p-price">¥{{item.price}}</text>
              <view class="p-add" catchtap="addToCart" data-item="{{item}}">+</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{!loading && groupedProducts.length === 0}}" class="empty-state">
      <text class="icon">🍽️</text>
      <text class="text">暂无商品</text>
    </view>

    <!-- 底部留白 -->
    <view style="height: 40rpx;"></view>
  </scroll-view>
</view>
