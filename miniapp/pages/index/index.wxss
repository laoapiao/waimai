/* === 顶栏 === */
.top-bar { background: linear-gradient(135deg, #ff6b35, #e05520); padding: 28rpx 24rpx 24rpx; }
.top-bar-inner { text-align: center; }
.top-row { display: flex; justify-content: flex-end; margin-bottom: 6rpx; }
.user-brief { display: flex; align-items: center; gap: 8rpx; background: rgba(255,255,255,0.2); padding: 6rpx 18rpx; border-radius: 28rpx; }
.user-avatar-sm { width: 32rpx; height: 32rpx; border-radius: 50%; }
.user-avatar-placeholder { font-size: 20rpx; }
.user-name-sm { font-size: 22rpx; color: #fff; }
.shop-name { font-size: 36rpx; font-weight: 800; color: #fff; display: block; }

/* === 公告 === */
.announce-bar { margin: 16rpx 20rpx; padding: 14rpx 20rpx; background: linear-gradient(135deg, #fff7e6, #ffe7ba); border-radius: 14rpx; display: flex; align-items: center; gap: 10rpx; border-left: 5rpx solid #faad14; }
.announce-icon { font-size: 28rpx; flex-shrink: 0; }
.announce-text { font-size: 24rpx; color: #8c6d1f; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* === 搜索 === */
.search-wrap { padding: 0 20rpx; margin-top: 10rpx; }
.search-box { display: flex; align-items: center; background: #fff; border-radius: 36rpx; padding: 0 24rpx; height: 68rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }
.search-icon { font-size: 28rpx; margin-right: 10rpx; }
.search-input { flex: 1; font-size: 26rpx; }

/* === 主体布局 === */
.main-body { display: flex; height: calc(100vh - 340rpx); margin-top: 16rpx; }

/* === 左侧分类 === */
.cate-sidebar { width: 170rpx; background: #f8f8f8; flex-shrink: 0; }
.cate-side-item { padding: 32rpx 16rpx; display: flex; align-items: center; justify-content: center; position: relative; border-bottom: 2rpx solid #ffe0cc; }
.cate-side-name { font-size: 28rpx; color: #555; text-align: center; line-height: 1.3; }
.cate-side-active { background: #fff; border-bottom-color: transparent; }
.cate-side-active .cate-side-name { color: #ff6b35; font-weight: 800; font-size: 32rpx; }
.cate-side-bar { position: absolute; left: 0; top: 20%; height: 60%; width: 5rpx; background: #ff6b35; border-radius: 3rpx; }

/* === 右侧商品 === */
.product-scroll { flex: 1; background: #fff; }

.section-header { padding: 20rpx 24rpx 8rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #333; }

.product-grid { display: flex; flex-wrap: wrap; padding: 0 12rpx; }
.p-card { width: calc(50% - 10rpx); margin: 5rpx; background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.04); }
.p-card:active { transform: scale(0.97); }

.p-img-wrap { position: relative; }
.p-img { width: 100%; height: 200rpx; background: #f5f5f5; }
.p-sales { position: absolute; bottom: 6rpx; left: 6rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 6rpx; }

.p-info { padding: 12rpx 14rpx; }
.p-name { font-size: 26rpx; font-weight: 600; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.p-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.p-price { font-size: 30rpx; font-weight: 800; color: #ff6b35; }

.p-add { width: 44rpx; height: 44rpx; border-radius: 50%; background: linear-gradient(135deg, #ff6b35, #e05520); color: #fff; font-size: 30rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; box-shadow: 0 3rpx 8rpx rgba(255,107,53,0.3); }

/* === 底部购物车悬浮栏 === */
.cart-float { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 16rpx 24rpx; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08); z-index: 100; }
.cart-float-left { display: flex; align-items: center; gap: 16rpx; }
.cart-float-icon { position: relative; width: 72rpx; height: 72rpx; background: linear-gradient(135deg, #ff6b35, #e05520); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.cart-float-badge { position: absolute; top: -6rpx; right: -6rpx; min-width: 32rpx; height: 32rpx; background: #ff4d4f; color: #fff; border-radius: 16rpx; font-size: 20rpx; display: flex; align-items: center; justify-content: center; padding: 0 6rpx; }
.cart-float-total { font-size: 32rpx; font-weight: 800; color: #ff6b35; }
.cart-float-empty { font-size: 26rpx; color: #999; }
.cart-float-btn { background: linear-gradient(135deg, #52c41a, #3cb371); color: #fff; border-radius: 40rpx; padding: 16rpx 48rpx; font-size: 28rpx; font-weight: 700; }
.cart-btn-disabled { background: #ccc; }
