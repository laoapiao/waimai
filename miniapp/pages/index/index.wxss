/* === 顶栏 === */
.top-bar {
  background: linear-gradient(135deg, #ff6b35, #e05520);
  padding: 40rpx 32rpx 32rpx;
}
.top-bar-inner { text-align: center; }
.top-row { display: flex; justify-content: flex-end; margin-bottom: 8rpx; }
.user-brief {
  display: flex; align-items: center; gap: 10rpx;
  background: rgba(255,255,255,0.2); padding: 8rpx 20rpx;
  border-radius: 32rpx;
}
.user-avatar-sm { width: 36rpx; height: 36rpx; border-radius: 50%; }
.user-avatar-placeholder { font-size: 22rpx; }
.user-name-sm { font-size: 24rpx; color: #fff; }
.shop-name { font-size: 40rpx; font-weight: 800; color: #fff; }
.shop-desc { display: block; font-size: 24rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; }

/* === 搜索 === */
.search-wrap { padding: 0 24rpx; margin-top: -20rpx; position: relative; z-index: 2; }
.search-box {
  display: flex; align-items: center;
  background: #fff; border-radius: 40rpx;
  padding: 0 28rpx; height: 76rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
}
.search-icon { font-size: 32rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; }

/* === 分类 === */
.cate-scroll { white-space: nowrap; padding: 24rpx 24rpx 8rpx; }
.cate-item {
  display: inline-block; padding: 12rpx 28rpx; margin-right: 14rpx;
  font-size: 26rpx; color: #666; background: #fff;
  border-radius: 32rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}
.cate-active { color: #fff; background: linear-gradient(135deg, #ff6b35, #e05520); }
.cate-icon-img { width: 32rpx; height: 32rpx; border-radius: 6rpx; margin-right: 4rpx; vertical-align: middle; }

/* === 商品网格 === */
.product-grid { display: flex; flex-wrap: wrap; padding: 16rpx 18rpx; }
.p-card {
  width: calc(50% - 12rpx); margin: 6rpx;
  background: #fff; border-radius: 20rpx;
  overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: transform 0.15s;
}
.p-card:active { transform: scale(0.97); }

.p-img-wrap { position: relative; }
.p-img { width: 100%; height: 240rpx; background: #f5f5f5; }
.p-sales {
  position: absolute; bottom: 8rpx; left: 8rpx;
  background: rgba(0,0,0,0.55); color: #fff;
  font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx;
}

.p-info { padding: 16rpx; }
.p-name { font-size: 28rpx; font-weight: 600; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.p-desc { font-size: 22rpx; color: #999; display: block; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.p-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 14rpx; }
.p-price { font-size: 32rpx; font-weight: 800; color: #ff6b35; }

.p-add {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #e05520);
  color: #fff; font-size: 36rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255,107,53,0.35);
}

/* === 空状态 === */
.empty-state { padding: 120rpx 0; }
