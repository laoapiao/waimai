/* 地址管理 */

.page { padding: 24rpx; padding-bottom: 120rpx; }
.addr-list { padding-bottom: 20rpx; }

.addr-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid transparent;
}
.addr-card.default { border-left-color: #ff6b35; }

.addr-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 10rpx; }
.addr-name { font-size: 32rpx; font-weight: 700; color: #333; }
.addr-phone { font-size: 26rpx; color: #999; }
.default-tag {
  background: #fff2e8; color: #ff6b35;
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 8rpx;
}

.addr-detail { font-size: 26rpx; color: #666; line-height: 1.5; margin-bottom: 16rpx; }

.addr-actions { display: flex; gap: 32rpx; border-top: 1rpx solid #f5f5f5; padding-top: 16rpx; }
.action-link { font-size: 26rpx; color: #ff6b35; }
.action-link.danger { color: #ff4d4f; }

/* 新增按钮 */
.bottom-btn { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 24rpx; background: #f5f5f5; }
.add-btn {
  background: linear-gradient(135deg, #ff6b35, #e05520);
  color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 700;
  height: 88rpx; line-height: 88rpx; border: none;
}

/* 弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx; z-index: 101;
}
.modal-title { font-size: 34rpx; font-weight: 800; margin-bottom: 28rpx; }
.modal-input {
  height: 84rpx; border: 1rpx solid #e8e8e8; border-radius: 16rpx;
  padding: 0 20rpx; font-size: 28rpx; margin-bottom: 16rpx;
  background: #fafafa;
}
.modal-save {
  background: linear-gradient(135deg, #ff6b35, #e05520);
  color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 700;
  height: 88rpx; line-height: 88rpx; border: none; margin-top: 16rpx;
}
