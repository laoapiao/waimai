/* 订单详情 */

.page { padding-bottom: 40rpx; }

/* 地图 */
.map-container { margin: 0 24rpx 16rpx; border-radius: 20rpx; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
.map { width: 100%; height: 360rpx; }
.map-tip {
  position: absolute; top: 20rpx; left: 50%; transform: translateX(-50%);
  background: rgba(0,0,0,0.72); color: #fff; padding: 12rpx 28rpx;
  border-radius: 36rpx; font-size: 24rpx; display: flex; gap: 16rpx; align-items: center;
}
.map-update { color: #52c41a; font-size: 22rpx; }

/* 区块 */
.section { background: #fff; margin: 0 24rpx 16rpx; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03); }

.status-bar { text-align: center; margin-bottom: 8rpx; }
.status-badge { font-size: 32rpx; font-weight: 800; }
.status-badge.pending { color: #faad14; }
.status-badge.accepted { color: #1890ff; }
.status-badge.delivering { color: #722ed1; }
.status-badge.completed { color: #52c41a; }
.status-badge.cancelled { color: #999; }

.info-row { display: flex; padding: 14rpx 0; font-size: 28rpx; border-bottom: 1rpx solid #f9f9f9; }
.info-label { width: 140rpx; color: #999; flex-shrink: 0; }

.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 18rpx; }

.item-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.item-img { width: 68rpx; height: 68rpx; border-radius: 10rpx; background: #f5f5f5; }
.item-info { flex: 1; margin-left: 16rpx; font-size: 28rpx; }
.item-price { font-size: 26rpx; color: #999; }

.total-row { display: flex; justify-content: flex-end; padding-top: 18rpx; border-top: 1rpx solid #f0f0f0; font-size: 30rpx; }
.total-price { color: #ff6b35; font-weight: 800; font-size: 38rpx; margin-left: 8rpx; }

.review-btn {
  background: linear-gradient(135deg, #ff6b35, #e05520);
  color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 700;
  border: none; height: 88rpx; line-height: 88rpx;
}

.review-rating { font-size: 44rpx; margin-bottom: 12rpx; }
.star { color: #e8e8e8; margin-right: 8rpx; }
.star.filled { color: #faad14; }
.review-content { font-size: 28rpx; color: #666; line-height: 1.6; }
