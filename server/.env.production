# ==========================================
# 阿飘菜市 - 生产环境配置
# ==========================================
# 部署到服务器后，复制为 .env 并填入实际值

NODE_ENV=production
PORT=3000

# --- 数据库（服务器上创建专用用户，不要用 root）---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=waimai
DB_USER=waimai_user
DB_PASSWORD=这里改成你的强密码

# --- JWT ---
# 在服务器上运行: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 把输出填到这里
JWT_SECRET=这里换成生成的随机64位字符串
JWT_EXPIRES_IN=7d

# --- 上传 ---
UPLOAD_MAX_SIZE=5242880
FILE_BASE_URL=https://你的域名.com

# --- CORS ---
CORS_ORIGIN=https://你的域名.com,https://www.你的域名.com
