# ==========================================
# 外卖系统 - 环境变量配置
# ==========================================
# 复制这个文件为 .env，然后填入你的实际配置
# 命令：cp .env.example .env

# --- 服务器 ---
PORT=3000
NODE_ENV=development

# --- 数据库 (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=waimai
DB_USER=root
DB_PASSWORD=你的MySQL密码

# --- JWT 配置 ---
# 密钥随便写一串字符串，越复杂越安全
JWT_SECRET=换成你自己的随机字符串
JWT_EXPIRES_IN=7d

# --- 文件上传 ---
# 上传文件大小限制 (5MB = 5242880)
UPLOAD_MAX_SIZE=5242880
